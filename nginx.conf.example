# ============================================
# Configurazione Nginx per Domotica Casa Lazise
# ============================================
#
# ISTRUZIONI:
# 1. Copia questo file in /etc/nginx/sites-available/domotica
# 2. Sostituisci 'tuodominio.com' con il tuo dominio
# 3. Sostituisci '/var/www/domotica' con il path della tua app
# 4. Ottieni certificato SSL: sudo certbot --nginx -d tuodominio.com
# 5. Crea symlink: sudo ln -s /etc/nginx/sites-available/domotica /etc/nginx/sites-enabled/
# 6. Testa config: sudo nginx -t
# 7. Riavvia nginx: sudo systemctl reload nginx

# Server HTTPS (porta 443)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name tuodominio.com www.tuodominio.com;

    # ====================================
    # CERTIFICATI SSL (Let's Encrypt)
    # ====================================
    ssl_certificate /etc/letsencrypt/live/tuodominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tuodominio.com/privkey.pem;

    # ====================================
    # CONFIGURAZIONE SSL
    # ====================================
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # OCSP Stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/letsencrypt/live/tuodominio.com/chain.pem;

    # ====================================
    # SECURITY HEADERS
    # ====================================

    # Force HTTPS per 1 anno
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Previeni clickjacking
    add_header X-Frame-Options "SAMEORIGIN" always;

    # Previeni MIME type sniffing
    add_header X-Content-Type-Options "nosniff" always;

    # XSS Protection
    add_header X-XSS-Protection "1; mode=block" always;

    # Referrer Policy
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Content Security Policy (già nel HTML, ma possiamo rinforzare)
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' https://tuodominio.com;" always;

    # ====================================
    # ROOT DIRECTORY
    # ====================================
    root /var/www/domotica;
    index index.html;

    # ====================================
    # LOGGING
    # ====================================
    access_log /var/log/nginx/domotica_access.log;
    error_log /var/log/nginx/domotica_error.log warn;

    # ====================================
    # GZIP COMPRESSION
    # ====================================
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss application/rss+xml font/truetype font/opentype application/vnd.ms-fontobject image/svg+xml;

    # ====================================
    # CACHE CONTROL
    # ====================================

    # Cache statico (immagini, font, etc)
    location ~* \.(jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Cache CSS e JS
    location ~* \.(css|js)$ {
        expires 1w;
        add_header Cache-Control "public, must-revalidate";
    }

    # No cache per HTML
    location ~* \.(html)$ {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # ====================================
    # PROXY PER SERVER DOMOTICO
    # ====================================

    # Proxy delle richieste al server domotico
    # IMPORTANTE: Cambia l'IP con quello del tuo server
    location /api/ {
        # Rimuovi /api/ dall'URL e passa al server domotico
        rewrite ^/api/(.*) /$1 break;

        proxy_pass http://94.185.76.20:8000;

        # Headers per proxy
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout
        proxy_connect_timeout 5s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;

        # CORS (se necessario)
        add_header Access-Control-Allow-Origin "https://tuodominio.com" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;

        # Risposta a preflight requests
        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }

    # ====================================
    # FALLBACK A index.html (SPA)
    # ====================================
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ====================================
    # SECURITY: BLOCCA FILE NASCOSTI
    # ====================================
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}

# ============================================
# REDIRECT HTTP -> HTTPS
# ============================================
server {
    listen 80;
    listen [::]:80;
    server_name tuodominio.com www.tuodominio.com;

    # Redirect permanente a HTTPS
    return 301 https://$server_name$request_uri;
}

# ============================================
# RATE LIMITING (opzionale ma consigliato)
# ============================================
# Aggiungi questo nel blocco http di nginx.conf:
#
# http {
#     # Limita a 10 richieste al secondo per IP
#     limit_req_zone $binary_remote_addr zone=domotica_limit:10m rate=10r/s;
#
#     # Poi nel server block aggiungi:
#     # location / {
#     #     limit_req zone=domotica_limit burst=20 nodelay;
#     # }
# }
